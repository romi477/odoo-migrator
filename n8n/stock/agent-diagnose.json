{
  "name": "agent-diagnose",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Diagnose the failure of ' + $json.module.technical_name + ' on attempt ' + $json.attempt + '. Rules:\\n' + JSON.stringify($json.rules) + '\\nFindings:\\n' + JSON.stringify($json.findings || []) + '\\nTest output:\\n' + JSON.stringify($json.test_output || '') + '\\nReturn JSON: { findings, needs_human, question, assumption, reexamine_old, diagnosis }' }}",
        "options": {
          "systemMessage": "={{ $json.system_prompt }}",
          "maxIterations": 8
        }
      },
      "id": "agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [440, 0]
    },
    {
      "parameters": {
        "model": {"__rl": true, "mode": "list", "value": "gpt-4o"},
        "options": {}
      },
      "id": "lm",
      "name": "Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [440, 240]
    },
    {
      "parameters": {
        "toolDescription": "Read a text file from the configured old or new project root",
        "method": "GET",
        "url": "={{ $('When Called').item.json.sheller_base_url }}/api/migrations/{{ $('When Called').item.json.migration_id }}/files",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "side", "value": "={{ $fromAI('side', 'old or new', 'string', 'new') }}"},
            {"name": "path", "value": "={{ $fromAI('path', 'path relative to that root', 'string') }}"}
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Odoo-Migrator-Key", "value": "={{ $env.MIGRATOR_API_KEY }}"}
          ]
        },
        "options": {}
      },
      "id": "read-file",
      "name": "Read file",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [220, 240]
    },
    {
      "parameters": {
        "toolDescription": "Run Python in the still-open old-container Sheller session",
        "method": "POST",
        "url": "={{ $('When Called').item.json.sheller_base_url }}/api/sessions/{{ $('When Called').item.json.old_session_id }}/exec",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Odoo-Migrator-Key", "value": "={{ $env.MIGRATOR_API_KEY }}"},
            {"name": "X-OS-Session-Key", "value": "={{ $('When Called').item.json.old_write_key }}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ code: $fromAI('code', 'Python to run in the old Odoo shell', 'string') }) }}",
        "options": {}
      },
      "id": "exec-old",
      "name": "Exec old",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [220, 400]
    },
    {
      "parameters": {
        "jsCode": "const job = $('When Called').item.json;\nconst raw = $json.output ?? $json;\nlet extra = {};\nif (typeof raw === 'string') { try { extra = JSON.parse(raw); } catch { extra = { output: raw }; } }\nelse if (raw && typeof raw === 'object') { extra = raw; }\nreturn [{ json: { ...job, ...extra, findings: extra.findings || job.findings || [], needs_human: Boolean(extra.needs_human), reexamine_old: Boolean(extra.reexamine_old), question: extra.question || '', diagnosis: extra.diagnosis || extra.output || '' } }];"
      },
      "id": "keep",
      "name": "Keep job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "When Called": {"main": [[{"node": "AI Agent", "type": "main", "index": 0}]]},
    "AI Agent": {"main": [[{"node": "Keep job", "type": "main", "index": 0}]]},
    "Chat Model": {"ai_languageModel": [[{"node": "AI Agent", "type": "ai_languageModel", "index": 0}]]},
    "Read file": {"ai_tool": [[{"node": "AI Agent", "type": "ai_tool", "index": 0}]]},
    "Exec old": {"ai_tool": [[{"node": "AI Agent", "type": "ai_tool", "index": 0}]]}
  },
  "settings": {}
}
