    {
      "parameters": {
        "jsCode": "// A module that passes first time used to log no attempt at all,\n// so the checkpoint had nothing to hang the rewrite's diff on \u2014\n// the one outcome the human most wants to look at.\nconst job = $json;\nconst attempt = Number(job.attempt) || 1;\nconst out = job.test_output;\nreturn [{ json: { ...job, status: 'passed', attempts: [...(job.attempts || []), {\n  iteration: attempt,\n  verdict: 'passed',\n  test_output: typeof out === 'string' ? out : (out ? JSON.stringify(out) : ''),\n}] } }];"
