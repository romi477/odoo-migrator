{
  "name": "sheller-close-session",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ $json.sheller_base_url }}/api/sessions/{{ $json.old_session_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Odoo-Migrator-Key", "value": "={{ $env.MIGRATOR_API_KEY }}"},
            {"name": "X-OS-Session-Key", "value": "={{ $json.old_write_key }}"}
          ]
        },
        "options": {}
      },
      "id": "close-old",
      "name": "Close old session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ $json.sheller_base_url }}/api/sessions/{{ $json.new_session_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Odoo-Migrator-Key", "value": "={{ $env.MIGRATOR_API_KEY }}"},
            {"name": "X-OS-Session-Key", "value": "={{ $json.new_write_key }}"}
          ]
        },
        "options": {}
      },
      "id": "close-new",
      "name": "Close new session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "When Called": {"main": [[{"node": "Close old session", "type": "main", "index": 0}]]},
    "Close old session": {"main": [[{"node": "Close new session", "type": "main", "index": 0}]]}
  },
  "settings": {}
}
