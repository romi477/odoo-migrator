{
  "name": "sheller-run-tests",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.sheller_base_url }}/api/sessions/{{ $json.new_session_id }}/run_test",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Odoo-Migrator-Key", "value": "={{ $env.MIGRATOR_API_KEY }}"},
            {"name": "X-OS-Session-Key", "value": "={{ $json.new_write_key }}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ test: $json.test }) }}",
        "options": {}
      },
      "id": "run-test",
      "name": "Run one test class",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const job = $('When Called').item.json;\nreturn [{ json: { ...job, passed: true, status: 'passed' } }];"
      },
      "id": "keep-ok",
      "name": "Tests passed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const job = $('When Called').item.json;\nreturn [{ json: { ...job, passed: false, test_output: typeof ($json.error || $json) === 'string' ? ($json.error || $json) : JSON.stringify($json.error || $json) } }];"
      },
      "id": "keep-fail",
      "name": "Tests failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 240]
    }
  ],
  "connections": {
    "When Called": {"main": [[{"node": "Run one test class", "type": "main", "index": 0}]]},
    "Run one test class": {"main": [[{"node": "Tests passed", "type": "main", "index": 0}], [{"node": "Tests failed", "type": "main", "index": 0}]]}
  },
  "settings": {}
}
