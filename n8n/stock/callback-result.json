{
  "name": "callback-result",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callback_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Odoo-Migrator-Key", "value": "={{ $env.MIGRATOR_API_KEY }}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id, status: $json.status, current_session_id: $json.new_session_id, attempts: $json.attempts || [], findings: $json.findings || [], assumptions: $json.assumptions || [], question: $json.question, resumeUrl: $json.resumeUrl }) }}",
        "options": {}
      },
      "id": "callback",
      "name": "Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "When Called": {"main": [[{"node": "Callback", "type": "main", "index": 0}]]}
  },
  "settings": {}
}
